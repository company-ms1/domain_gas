{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru/mcp/",
      "destination": "/ru/mcp",
      "permanent": true
    },
    {
      "source": "/ru/mcp.html",
      "destination": "/ru/mcp",
      "permanent": true
    },
    {
      "source": "/en/mcp/",
      "destination": "/en/mcp",
      "permanent": true
    },
    {
      "source": "/en/mcp.html",
      "destination": "/en/mcp",
      "permanent": true
    },
    {
      "source": "/es/mcp/",
      "destination": "/es/mcp",
      "permanent": true
    },
    {
      "source": "/es/mcp.html",
      "destination": "/es/mcp",
      "permanent": true
    },
    {
      "source": "/id/mcp/",
      "destination": "/id/mcp",
      "permanent": true
    },
    {
      "source": "/id/mcp.html",
      "destination": "/id/mcp",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://connector.gasfree4you.com/mcp"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(en|ru|es|id)/blog",
      "destination": "/:lang/blog/index.html"
    },
    {
      "source": "/:lang(en|ru|es|id)/blog/",
      "destination": "/:lang/blog/index.html"
    },
    {
      "source": "/ru/mcp",
      "destination": "/ru/mcp.html"
    },
    {
      "source": "/en/mcp",
      "destination": "/en/mcp.html"
    },
    {
      "source": "/es/mcp",
      "destination": "/es/mcp.html"
    },
    {
      "source": "/id/mcp",
      "destination": "/id/mcp.html"
    }
  ]
}
