{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {"source": "/index.html", "destination": "/", "permanent": true}
  ],
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/:lang(en|ru|es|id)/blog", "destination": "/:lang/blog/index.html"},
    {"source": "/:lang(en|ru|es|id)/blog/", "destination": "/:lang/blog/index.html"}
  ]
}
